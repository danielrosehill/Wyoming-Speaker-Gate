# Upstream Wyoming STT the gate forwards to
UPSTREAM=tcp://192.168.1.10:10300
# Hugging Face token (the pyannote WeSpeaker model may need an accepted licence)
HF_TOKEN=
# Accept cosine (0-1). Override per speaker: SPEAKER_THRESHOLDS=--speaker-threshold Alice=0.35
THRESHOLD=0.40
SPEAKER_THRESHOLDS=
# enforce = block unknown speakers; shadow = log scores only
MODE=enforce
# EXTRA_ARGS=--log-text
# Keep each command as WAV + JSON in data/recordings/YYYY-MM-DD/ (on by default); days to keep
RECORD=1
RECORD_RETENTION_DAYS=7
BIND=0.0.0.0
PORT=10310
SUBNET=172.16.60.0/24
